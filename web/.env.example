# BeautIzzy web — environment contract (placeholders only).
#
# Copy to `.env.local` (gitignored) and fill what you need. The marketing
# pages need nothing. The public profile pages (/r/<slug>) need the Supabase
# project URL and the secret key; without them they answer an error, never a
# fabricated page.
#
# Never copy values from the mobile application's .env files into a committed
# file, and never commit a real key.

# --- Public (inlined into the browser bundle) --------------------------------

# Canonical origin of the website, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown on the marketing pages. Empty: no contact link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase project URL (https://<project-ref>.supabase.co): the server-side
# profile lookup and the public URLs of branding images. Staging while online
# booking is being validated.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase PUBLISHABLE key (sb_publishable_…). Unused: no browser code calls
# Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never prefixed NEXT_PUBLIC_) -------------------------------

# Supabase SECRET key (sb_secret_…) of the SAME project as the URL above. Read
# only through src/lib/env/server.ts, by the public profile lookup. Never
# commit it, never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Development / Staging ONLY: `enabled` shows the read-only availability
# preview on /r/<slug>/reserver (services, dates, start times — nothing can be
# booked). Absent: the « pas encore disponible » notice. Ignored when
# NEXT_PUBLIC_SITE_URL is the production website. Never set it in production.
ONLINE_BOOKING_AVAILABILITY_PREVIEW=

# Development / Staging ONLY: `enabled` opens the public booking flow on
# /r/<slug>/reserver and its endpoints under /api/booking/<slug>. Real
# appointments are created (when the database's ONLINE_BOOKING_CREATION switch
# is on). Ignored when NEXT_PUBLIC_SITE_URL is the production website. Never
# set it in production.
ONLINE_BOOKING_WEB_BOOKING=

# Required by the booking flow: a random string of at least 32 characters,
# distinct per environment (e.g. `openssl rand -hex 32`). It turns IP
# addresses, emails and slugs into opaque request-counter keys. Absent or too
# short: every booking endpoint refuses (fail closed). Never commit it.
ONLINE_BOOKING_REQUEST_LIMIT_SECRET=

# Required by the booking flow: the Cloudflare Turnstile widget (managed mode)
# of THIS environment — one widget per environment, its hostname being this
# site's. The site key is public (the server hands it to the page); the secret
# is server-only. Absent, mixed or malformed: the flow is not offered and every
# booking is refused (fail closed). Locally, Cloudflare's TEST keys may be used
# (always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA);
# they are refused unless NEXT_PUBLIC_SITE_URL and the request are local.
# Never commit a real secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OPTIONAL — the map of a published location (Apple Maps Web Snapshots). Three
# values of ONE Apple Developer account: the Team ID, the Key ID of a key with
# the MapKit JS service enabled, and that key's private key (the text of its
# .p8 file; on one line, write its line breaks as \n). The server signs each
# snapshot URL with it (ES256) and the visitor's browser loads the image from
# Apple. Without all three — or with a malformed one — pages show their own
# artwork instead of a map; the address and « Itinéraire » work the same.
# Server-only: never prefix them NEXT_PUBLIC_, never commit a real key.
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
