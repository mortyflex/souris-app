# BeautIzzy web — environment contract (placeholders only).
#
# Copy to `.env.local` (gitignored) and fill what you need. Sprint 1 needs
# nothing: every variable is optional and no Supabase connection is opened.
#
# Never copy values from the mobile application's .env files into a committed
# file, and never commit a real key.

# --- Public (inlined into the browser bundle) --------------------------------

# Canonical origin of the website, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown on the marketing pages. Empty: no contact link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase project URL and PUBLISHABLE key (sb_publishable_…). Unused until
# booking is implemented.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never prefixed NEXT_PUBLIC_) -------------------------------

# Supabase SECRET key for the future booking server modules. Read only through
# src/lib/env/server.ts. Unused in Sprint 1 — leave empty.
SUPABASE_SECRET_KEY=
