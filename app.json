{
  "expo": {
    "name": "BeautIzzy",
    "slug": "souris-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon/icon.png",
    "scheme": "sourisapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3F8",
    "ios": {
      "bundleIdentifier": "com.mortyflex.sourisapp",
      "icon": "./assets/brand/app-icon/BeautIzzy.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#320882",
        "foregroundImage": "./assets/brand/app-icon/android-foreground.png",
        "monochromeImage": "./assets/brand/app-icon/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/logo-primary.png",
          "imageWidth": 252,
          "android": {
            "image": "./assets/brand/app-icon/android-splash.png",
            "imageWidth": 288
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "BeautIzzy utilise l’appareil photo pour ajouter des photos de vos clients et de vos produits, et pour scanner les codes-barres des produits.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BeautIzzy accède à vos photos pour ajouter une photo à un client ou à un produit.",
          "cameraPermission": "BeautIzzy utilise l’appareil photo pour ajouter des photos de vos clients et de vos produits, et pour scanner les codes-barres des produits.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": "BeautIzzy accède à vos photos pour ajouter une photo à un client ou à un produit.",
          "savePhotosPermission": "BeautIzzy enregistre dans Photos les images que vous créez, comme vos Tops & tendances.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41670724-510f-41c7-a17c-282b9250c888"
      }
    }
  }
}
