# BeautIzzy — Supabase client configuration (public values, shipped inside the app)
#
# Both values come from the Supabase dashboard: Project › Connect › App Frameworks
# (Expo / React Native), or Project Settings › API Keys.
#
#   EXPO_PUBLIC_SUPABASE_URL              the project URL: https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY  the PUBLISHABLE key (sb_publishable_…)
#
# Never put the secret key (sb_secret_…), the service_role key, or the
# database password here: security comes from Auth + Row Level Security.
#
# Copy this file to `.env` (gitignored) and fill both values, then restart
# `npx expo start` so the values are inlined into the JavaScript bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# BeautIzzy Plus — RevenueCat PUBLIC SDK keys (they ship inside the app; the
# secret API keys never do). Which one a build uses is decided by
# src/infrastructure/revenuecat/config.ts:
#
#   EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY  RevenueCat Test Store key (test_…): development
#                                              bundles ONLY (`__DEV__`), never a release
#   EXPO_PUBLIC_REVENUECAT_IOS_API_KEY         Apple App Store key (appl_…): iOS release builds,
#                                              TestFlight included — and the Apple Sandbox
#                                              development mode (Phase 6.4A/B), a DEBUG build
#                                              started with APP_VARIANT=apple-sandbox, which
#                                              reads the real App Store products
#   EXPO_PUBLIC_REVENUECAT_APPLE_SANDBOX_TEST_ACCOUNTS
#                                              Phase 6.4B, Apple Sandbox mode ONLY: the DEDICATED
#                                              TEST ACCOUNTS (Supabase user ids or emails, comma-
#                                              separated) that may purchase and restore from the
#                                              development preview. Never a professional's or a
#                                              pilot's account. Empty or absent: nobody may.
#                                              Ignored by every other build.
#
# Android release builds stay unconfigured until Google Play exists. A missing
# or invalid key never crashes the app: the subscription is simply unverifiable.
# No variable here enables Apple purchases for the product: that is a build
# constant (src/features/access/purchasable-stores.ts), the Test Store only
# today. The Apple Sandbox test purchase additionally requires iOS, a debug
# bundle, APP_VARIANT=apple-sandbox, the developer preview and a declared test
# account (src/features/access/purchase-authorization.ts). Whether a
# transaction runs in Apple's Sandbox is decided by StoreKit — a development-
# signed build and a Sandbox tester Apple account on the device — never by
# these variables.

EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_APPLE_SANDBOX_TEST_ACCOUNTS=

# Native Google sign-in — PUBLIC OAuth client IDs (docs/architecture/AUTH.md §4b). Never a Google
# client SECRET. Both empty: « Continuer avec Google » answers that it is not available.
#
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID  the « Web application » client listed FIRST in this Supabase
#                                     project's Google provider (Client IDs)
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID  the « iOS » client of the bundle identifier you build:
#                                     com.mortyflex.sourisapp.dev (APP_VARIANT=development, Staging)
#                                     or com.mortyflex.sourisapp (release, Production). app.config.js
#                                     derives the iOS URL scheme from it: run `npx expo prebuild --clean`
#                                     after changing it.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Online booking — the PUBLIC origin of the BeautIzzy website (web/), without a trailing slash,
# e.g. http://localhost:3000 in development. Used only to show and open the professional's public
# page (/r/<slug>) and to copy its link. Empty: the app shows the path of the page and offers no link.
# Only https://beautizzy.fr (production) is presented as a link to share with clients; any other
# origin (localhost, a LAN address, Staging, a preview deployment) is labelled « Lien de test ».

EXPO_PUBLIC_WEB_URL=
